# Copy to .env and replace every placeholder. Never commit .env.

PORT=5001
APP_ENV=development

# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Base URL used in verification and reset links.
APP_BASE_URL=http://localhost:3001
SESSION_COOKIE_SECURE=false

# SQLite is used when DATABASE_URL is blank.
DATABASE_URL=

# SMTP (Gmail: smtp.gmail.com, port 587, secure=false; use a Google App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@example.com
SMTP_PASSWORD=your-provider-app-password
SMTP_FROM=TrendTide <your-address@example.com>

# Use a shared Redis URL in multi-worker production deployments.
RATELIMIT_STORAGE_URI=memory://

# Optional data source credentials.
X_BEARER_TOKEN=
TWITTER_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
